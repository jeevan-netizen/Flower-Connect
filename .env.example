# FlowerConnect environment configuration
# Copy this file to .env and fill in real values before running locally.
# Never commit a populated .env to version control.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=flowerconnect
DB_USER=flowerconnect
DB_PASS=CHANGE_ME_DB_PASSWORD
DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useUnicode=true&useJDBCCompliantTimezoneShift=true&useLegacyDatetimeServer=false&serverTimezone=UTC

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- JWT ---
JWT_SECRET=CHANGE_ME_JWT_SECRET_256_BITS
JWT_ACCESS_TTL_MS=900000
JWT_REFRESH_TTL_MS=604800000

# --- Application ---
APP_BASE_URL=http://localhost:5173
APP_CORS_ORIGINS=http://localhost:5173

# --- Email (notification phase) ---
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME

# --- Stripe (billing phase) ---
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME